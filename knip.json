{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs"],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.mjs", "*.ts", "*.js"],
  "ignore": [".claude/**"],
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "ignoreBinaries": ["pgrep", "desktop-file-validate", "shellcheck"]
}
