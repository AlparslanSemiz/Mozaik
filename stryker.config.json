{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutasyon testi. Kosucunun config'i vite.mutasyon.config.ts, cunku belge kapilari kum havuzunda kosamaz ve kosmasinin anlami da yok; gerekcesi o dosyanin basinda. Yalniz saf cekirdek mutasyona ugrar: butun depoyu olcmek pahali ve bilesenlerin olculdugu yer E2E. Ne olctugu ve ne zaman kostugu docs/TESTPLAN.md'de. dryRunTimeoutMinutes: enstrumante ilk kosu 2026-10-09'da varsayilan 5 dakikayi asti ve butun kosuyu dusurdu (TESTFINDINGS). tempDirName scratch/ altinda, test-results/ altinda degil: her Playwright kosusu test-results/'u bosaltir ve kum havuzunu kosunun ortasinda siler (TRAPS, tuzak 131).",
  "ignorePatterns": [
    ".venv",
    "dist",
    "dist-site",
    "dist-kurulum",
    "test-results",
    "src-tauri",
    "docs",
    "scratch",
    "e2e",
    "site",
    "kurulum",
    ".playwright-mcp",
    ".github",
    "*.zip",
    "*.png",
    "*.ico"
  ],
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.mutasyon.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/pure/constraints/occupancy.ts",
    "src/pure/constraints/engine.ts",
    "src/pure/constraints/blocks.ts",
    "src/pure/constraints/placing.ts",
    "src/pure/constraints/drop.ts",
    "src/pure/constraints/closed.ts",
    "src/pure/constraints/sanitize.ts",
    "src/pure/constraints/pins.ts",
    "src/pure/constraints/rules.ts",
    "src/leaf/model/blocks.ts",
    "src/pure/io/parseState.ts",
    "src/pure/undo/undo.ts",
    "src/pure/io/library.ts",
    "src/pure/feasibility/feasibility.ts",
    "src/pure/entities/identity.ts",
    "src/pure/entities/defaults.ts",
    "src/pure/entities/subjects.ts",
    "src/pure/entities/roster.ts",
    "src/pure/entities/lessons.ts",
    "src/pure/entities/settings.ts",
    "src/pure/entities/availability.ts",
    "src/pure/entities/rows.ts",
    "src/pure/entities/counting.ts",
    "src/pure/entities/deleting.ts",
    "src/pure/entities/inspect.ts",
    "src/pure/entities/answers.ts",
    "src/pure/entities/relations.ts",
    "src/pure/solver/solver.ts"
  ],
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "test-results/mutasyon/mutation.json"
  },
  "htmlReporter": {
    "fileName": "test-results/mutasyon/mutation.html"
  },
  "clearTextReporter": {
    "maxTestsToLog": 1
  },
  "concurrency": 4,
  "timeoutMS": 20000,
  "dryRunTimeoutMinutes": 20,
  "timeoutFactor": 2.5,
  "tempDirName": "scratch/mutasyon-tmp",
  "cleanTempDir": true,
  "disableTypeChecks": true
}
