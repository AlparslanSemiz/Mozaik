{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutasyon testi. Kosucunun config'i vite.mutasyon.config.ts, cunku belge kapilari kum havuzunda kosamaz ve kosmasinin anlami da yok; gerekcesi o dosyanin basinda. Yalniz saf cekirdek mutasyona ugrar: butun depoyu olcmek pahali ve bilesenlerin olculdugu yer E2E. Ne olctugu ve ne zaman kostugu docs/TESTPLAN.md'de.",
  "ignorePatterns": [
    ".venv",
    "dist",
    "dist-site",
    "dist-kurulum",
    "test-results",
    "src-tauri",
    "docs",
    "scratch",
    "e2e",
    "site",
    "kurulum",
    ".playwright-mcp",
    ".github",
    "*.zip",
    "*.png",
    "*.ico"
  ],
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.mutasyon.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/pure/constraints.ts",
    "src/pure/rules.ts",
    "src/leaf/blocks.ts",
    "src/pure/parseState.ts",
    "src/pure/undo.ts",
    "src/pure/library.ts",
    "src/pure/feasibility.ts",
    "src/pure/entities.ts",
    "src/pure/solver.ts"
  ],
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "test-results/mutasyon/mutation.json"
  },
  "htmlReporter": {
    "fileName": "test-results/mutasyon/mutation.html"
  },
  "clearTextReporter": {
    "maxTestsToLog": 1
  },
  "concurrency": 4,
  "timeoutMS": 20000,
  "timeoutFactor": 2.5,
  "tempDirName": "test-results/mutasyon/tmp",
  "cleanTempDir": true,
  "disableTypeChecks": true
}
