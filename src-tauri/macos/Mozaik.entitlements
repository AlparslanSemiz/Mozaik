<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Ad-hoc imzada Team ID yok, yani sertleştirilmiş çalışma zamanının kütüphane
       doğrulaması Contents/Frameworks'teki OR-Tools dylib'lerini reddediyor
       ("different Team IDs", ölçüldü 2026-11-16). Developer ID ile imzalanınca
       surum.yml bu dosyayı çıkarır: aynı ekip, doğrulama açık kalır. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
