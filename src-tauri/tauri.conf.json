{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mozaik",
  "version": "../package.json",
  "identifier": "com.dersprogrami.arac",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mozaik",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "resizable": true,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/kancalar.nsh",
        "languages": ["Turkish"],
        "displayLanguageSelector": false
      }
    },
    "icon": ["../site/icon-192.png", "../site/icon-512.png", "../kurulum/icon.ico"]
  }
}
