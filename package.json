{
  "name": "ders-programi",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "description": "Weekly school timetable builder - one file, no server, no internet",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "tsc --noEmit && vite build --config vite.site.config.ts",
    "sunucu": "vite build --config vite.site.config.ts && node scripts/sunucu.mjs",
    "paket": "npm run build:site && node scripts/paket.mjs",
    "test": "vitest run",
    "test:izle": "vitest",
    "tipler": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint src",
    "knip": "knip",
    "sinir": "depcruise src --output-type err",
    "analiz": "ANALIZ=1 vite build && echo test-results/demet/analiz.html",
    "boyut": "size-limit",
    "kapsam": "vitest run --coverage",
    "grafik": "depcruise src --output-type mermaid",
    "bicim": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js}\"",
    "kontrol": "npm run tipler && npm run sinir && npm run lint && vitest run && vite build && npm run boyut && playwright test && npm run test:site && playwright test --config playwright.cozucu.config.ts",
    "test:e2e": "vite build && playwright test",
    "test:site": "vite build && vite build --config vite.site.config.ts && playwright test --config playwright.site.config.ts",
    "ekran": "vite build && playwright test --config playwright.ekran.config.ts",
    "cozucu": "vite build && playwright test --config playwright.cozucu.config.ts",
    "mutasyon": "stryker run",
    "patrol": "vite build && playwright test --config playwright.patrol.config.ts",
    "font": "node scripts/font.mjs",
    "exe": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --release",
    "exe:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "exe:linux": "npm run exe && node scripts/exe-linux.mjs",
    "exe:e2e": "npm run exe:linux && playwright test --config playwright.gercek-exe.config.ts",
    "yayinla": "node scripts/yayinla.mjs"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "lucide-react": "^1.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^13.0.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.0",
    "jsdom": "^29.1.1",
    "knip": "^6.35.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^13.0.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.0"
  }
}
