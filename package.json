{
  "name": "ders-programi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Haftalik ders programi dizme araci - tek dosya, sunucusuz, internetsiz",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "tsc --noEmit && vite build --config vite.site.config.ts",
    "test": "vitest run",
    "test:izle": "vitest",
    "kontrol": "tsc --noEmit && vitest run && vite build && playwright test && npm run test:site",
    "test:e2e": "vite build && playwright test",
    "test:site": "vite build && vite build --config vite.site.config.ts && playwright test --config playwright.site.config.ts",
    "ekran": "vite build && playwright test --config playwright.ekran.config.ts",
    "gorsel": "vite build && playwright test --config playwright.gorsel.config.ts",
    "cozucu": "vite build && playwright test --config playwright.cozucu.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.0"
  }
}
